# ============ Web 服务监听 ============
# 应用监听端口(本地运行时修改;Docker 部署时建议保持 8000 不动,改下面的 SPARK_WEB_PORT)
SPARK_PORT=8000
SPARK_HOST=0.0.0.0

# Docker 部署时:浏览器访问的宿主端口(默认 8000,想换就改这里,例如 9000)
# 修改后访问地址变为 http://127.0.0.1:9000
# SPARK_WEB_PORT=8000

# ============ 网页访问令牌 ============
# 强烈建议修改;留空则不鉴权
SPARK_TOKEN=spark_secret_token_change_me

# ============ 数据目录 ============
# 默认项目内 ./data
# SPARK_DATA=/app/data

# ============ 时区 ============
TZ=Asia/Shanghai

# ============ (可选)Docker 构建镜像源 ============
# 国内构建加速;默认已用阿里云镜像,一般不用改。
# 备选:mirrors.tuna.tsinghua.edu.cn(清华)、mirrors.ustc.edu.cn(中科大)
# APT_MIRROR=mirrors.aliyun.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
